# Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# Application Settings
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api/v1
PROJECT_NAME="Shared Finance App"

# Security
SECRET_KEY=<GENERATE_STRONG_SECRET_KEY_HERE>  # Use: openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database
DATABASE_URL=postgresql://user:password@db-host:5432/finance_app_production
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis-host:6379/0

# Stripe (Production Keys)
STRIPE_SECRET_KEY=sk_live_YOUR_PRODUCTION_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PRODUCTION_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_PRODUCTION_WEBHOOK_SECRET

# Email (Production SMTP)
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USERNAME=noreply@yourdomain.com
EMAIL_PASSWORD=<YOUR_SMTP_PASSWORD>
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME="Finance App"

# Frontend URL
FRONTEND_URL=https://yourdomain.com

# Monitoring & Logging
LOG_LEVEL=INFO
SENTRY_DSN=<YOUR_SENTRY_DSN>  # Optional: for error tracking

# Performance
WORKERS=4  # Number of Gunicorn workers
